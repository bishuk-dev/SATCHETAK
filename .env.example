# Copy this file to .env and replace only the values you use.
# Backend secrets stay here and must never be put in frontend/.env.local.

# Required for live Sentinel-2 discovery and pixel processing.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Local Ollama/Qwen explanation layer.
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen2.5:1.5b
QWEN_API_KEY=ollama

# Optional Bhoonidhi catalogue integration.
BHOONIDHI_USER_ID=
BHOONIDHI_PASSWORD=
BHOONIDHI_COLLECTION=

# Public catalogue fallback; no key required.
PLANETARY_COMPUTER_ENABLED=true

# Application settings.
SATCHETAK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SATCHETAK_CA_BUNDLE=C:\path\to\organization-ca-chain.pem
# SATCHETAK_DATA_DIR=C:\path\to\satchetak-data
